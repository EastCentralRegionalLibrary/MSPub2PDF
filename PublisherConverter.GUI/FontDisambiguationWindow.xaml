<Window x:Class="PublisherConverter.GUI.FontDisambiguationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multiple font matches found"
        Height="400"
        Width="520"
        MinHeight="300"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText"
                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
            <ListBox x:Name="CandidateList" BorderThickness="0" Padding="4"
                     MouseDoubleClick="CandidateList_MouseDoubleClick" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="30" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="SelectButton" Content="Use selected" Width="120" Height="30"
                    IsDefault="True" Click="Select_Click" />
        </StackPanel>
    </Grid>
</Window>
