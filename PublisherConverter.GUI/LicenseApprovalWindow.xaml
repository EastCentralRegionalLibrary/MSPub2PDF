<Window x:Class="PublisherConverter.GUI.LicenseApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font license review"
        Height="500"
        Width="620"
        MinHeight="380"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="This font needs a license review before it can be installed"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:" FontWeight="SemiBold" Margin="0,0,10,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FontNameText" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Source:" FontWeight="SemiBold" Margin="0,0,10,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SourceText" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason:" FontWeight="SemiBold" Margin="0,0,10,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ReasonText" TextWrapping="Wrap" Margin="0,0,0,4" />
        </Grid>

        <TextBlock Grid.Row="2" Text="License text" FontWeight="SemiBold" Margin="0,8,0,4" />

        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
            <TextBox x:Name="LicenseTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Padding="8"
                     FontFamily="Consolas" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SkipButton" Content="Skip" Width="100" Height="30" Margin="0,0,8,0"
                    IsDefault="True" IsCancel="True" Click="Skip_Click" />
            <Button x:Name="InstallButton" Content="Install" Width="100" Height="30" Click="Install_Click" />
        </StackPanel>
    </Grid>
</Window>
