<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PublisherConverter.Core\PublisherConverter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>PublisherConverter.GUI.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationIcon>PubtoPdf.ico</ApplicationIcon>
    <AssemblyName>Pub2PDF</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <NoWarn>$(NoWarn);NU1701;NU1902</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
